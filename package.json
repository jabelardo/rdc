{
  "name": "rdc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:node": "node scripts/check-node-version.mjs",
    "check:bundle-boundary": "node scripts/check-bundle-boundary.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "pretest": "node scripts/check-node-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "docker compose -f docker-compose.e2e.yml run --rm --build e2e",
    "qualify:phase8a": "node scripts/check-node-version.mjs && node --test --test-timeout=10000 scripts/qualify-phase8a.node-test.mjs scripts/create-phase8b-fixture.node-test.mjs && node scripts/qualify-phase8a.mjs",
    "fixture:phase8b": "node scripts/check-node-version.mjs && node scripts/create-phase8b-fixture.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "re2js": "^2.8.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semver": "^7.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "selenium-webdriver": "^4.46.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.17.0"
}
