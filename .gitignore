# Logs
# Anchored to the repo root on purpose: an unanchored `logs` also matches
# src-tauri/crates/git-ops/tests/fixtures/**/_git/logs, which would silently commit the git
# fixtures without their reflogs and break any test that reads reflog history.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.pnpm-store
dist
dist-ssr
# tsc --build output for the tsconfig.node.json project reference
*.tsbuildinfo
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.claude/settings.local.json
