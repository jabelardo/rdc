{
  "compilerOptions": {
    /* target/lib match desktop-plus's tsconfig so ported code that relies on
       ES2022+ builtins (Array.at, Object.hasOwn, ...) still compiles. */
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Scoped to shadcn's vendored components (src/components/ui/**), which import each other and
       src/lib/utils.ts by this alias per shadcn's own convention. The rest of the codebase keeps
       its existing relative-import convention; this is not a general-purpose alias to adopt
       elsewhere. No `baseUrl` — deprecated in TS 6, and `paths` alone resolves fine under
       `moduleResolution: "bundler"`. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Required by ported desktop-plus code and tests:
       - esModuleInterop: tests do `import assert from 'node:assert'`
       - useUnknownInCatchVariables: false matches desktop-plus, whose code
         reads `.message`/`.name` off caught values directly. Revisit when the
         ported code is modernized rather than loosening it further. */
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
